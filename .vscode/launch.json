{
    // 详见 https://go.microsoft.com/fwlink/?linkid=830387
    // 不用 windows/osx 自动切换块判断"远程 Linux 还是本地 Windows"——VS Code 判断
    // 平台用的是本地客户端系统，从 Windows 客户端连远程 Linux 时也会被判成
    // windows，所以远程 Linux 和本地 Windows 分成两份独立命名的配置，手动选择
    "version": "0.2.0",
    "configurations": [
        {
            "name": "调试当前文件",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "C++: build active file",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印（STL 容器可读）",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "osx": {
                // macOS 用 lldb：gdb 需要代码签名，且在 Apple Silicon 上不支持 arm64
                // 不写 miDebuggerPath，交给 C/C++ 插件自己找
                // 注意：lldb 下 cin 交互输入用不了（DEBUG CONSOLE 不转发给 stdin，
                // externalConsole 弹的窗口在 mac 上也没真正接上子进程），需要交互输入
                // 时用下面的 "调试当前文件（CodeLLDB，支持交互输入）" 配置
                "MIMode": "lldb",
                "setupCommands": []
            }
        },
        {
            // ===== 本地 Mac，需要交互输入时用这个 =====
            // 用 CodeLLDB 插件（vadimcn.vscode-lldb）而不是 cpptools 的 lldb，
            // 它能把被调试进程真正接到 VS Code 集成终端上，cin 交互输入可以正常用
            "name": "调试当前文件（CodeLLDB，支持交互输入）",
            "type": "lldb",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}",
            "args": [],
            "cwd": "${fileDirname}",
            "terminal": "integrated",
            "preLaunchTask": "C++: build active file"
        },
        {
            "name": "调试当前文件（从 in.txt 读输入）",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}",
            // 用 shell 重定向把同目录下的 in.txt 作为标准输入
            "args": [
                "<",
                "${fileDirname}/in.txt"
            ],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "C++: build active file",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印（STL 容器可读）",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "osx": {
                "MIMode": "lldb",
                "setupCommands": []
            }
        },
        {
            // ===== 本地 Windows（MinGW）调试 =====
            // 只在本地原生 Windows 会话（未连接远程）里手动选用
            "name": "调试当前文件（本地 Windows MinGW）",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "D:/ProgramFiles/MinGW/bin/gdb.exe",
            "preLaunchTask": "C++: build active file (本地 Windows MinGW)",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印（STL 容器可读）",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
